# Serves the static SvelteKit build inside the container (see Dockerfile).
# On vps02 it listens only on the NetBird address; Caddy on vps03 terminates TLS
# for signalscout.yob-yob.com and proxies here over the mesh.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static 100.102.65.205 # vps03's NetBird IP, the only client
	}
}

:80 {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Cache: immutable SvelteKit assets (content-hashed filenames) forever, everything
	# else (HTML, txt, ...) revalidated. Two exclusive matchers, so neither overrides the other.
	@immutable path /_app/immutable/*
	@mutable not path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @mutable Cache-Control "public, max-age=0, must-revalidate"

	root * /srv

	# Handle static files
	file_server {
		hide .git
		hide .env*
	}

	# Compression — zstd first, gzip fallback (brotli not included in stock Caddy build)
	encode {
		zstd
		gzip
	}

	# direct file, page.html, folder index, then the SPA fallback (adapter-static fallback)
	try_files {path} {path}.html {path}/index.html /index.html
}
